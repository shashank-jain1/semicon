<% const items = s.items || []; %>
<section class="sec quotes-sec" <% if (sec.anchor) { %>id="<%= sec.anchor %>"<% } %>>
  <div class="container">
    <%- include('../partials/sectionHead', { s: s, align: 'center' }) %>
    <div class="quotes" data-quotes data-reveal>
      <span class="quotes__mark"><%- h.icon('quote') %></span>
      <div class="quotes__stage">
        <% items.forEach(function (q, i) { %>
          <figure class="quote<%= i === 0 ? ' is-active' : '' %>" data-quote>
            <blockquote><%= q.quote %></blockquote>
            <figcaption><b><%= q.name %></b><span><%= q.role %></span></figcaption>
          </figure>
        <% }) %>
      </div>
      <% if (items.length > 1) { %>
      <div class="quotes__nav">
        <% items.forEach(function (q, i) { %><button class="quotes__dot<%= i === 0 ? ' is-active' : '' %>" data-quote-dot aria-label="Show quote <%= i + 1 %>"><i></i></button><% }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>
